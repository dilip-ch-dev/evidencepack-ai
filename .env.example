## Database URLs (Postgres / Neon)
# Used by `prisma/schema.prisma` datasource via `env("PROD_DATABASE_URL")`.
PROD_DATABASE_URL="postgresql://YOUR_NEON_USER:YOUR_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require"

# Used by the Prisma `directUrl` (recommended for some environments).
DIRECT_URL="postgresql://YOUR_NEON_USER:YOUR_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require"

## Public app name
NEXT_PUBLIC_APP_NAME="EvidencePack AI"

## Gemini API
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

## Optional overrides (match code defaults if you omit)
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBED_MODEL="gemini-embedding-001"

## API write protection (recommended on Vercel)
# When set, POST /api/v1/* write routes require Authorization: Bearer <key> or x-api-key.
EVIDENCEPACK_API_KEY=""

## Demo cleanup (optional)
# Enables POST /api/v1/demo/reset to delete non-[SAMPLE DATA] systems.
DEMO_RESET_KEY=""
